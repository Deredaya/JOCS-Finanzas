---
import '@styles/income.scss'
import Layout from '@layouts/Layout.astro';

import OthersIcon from '@icons/Others.astro';
import JobIcon from '@icons/income/Job.astro';

import { getSession } from 'auth-astro/server';
const session = await getSession(Astro.request);
const userId = session?.user?.id;
---

<Layout>
  <main class="contentIncome">
    <section class="income">
      <p class="text">AGREGAR INGRESOS</p>

      <section class="fortnightly">
        <label>INGRESO QUINCENAL</label>
        <input type="text" id="moneda" inputmode="decimal" placeholder="$0.00">

        <script src="@scripts/components/cashInput.js"></script>
      </section>
      
      <section class="Pay">
        <label>FECHA DE INGRESO</label>
        <div class="DatePay">
          <input class="InputDate" type="date" name="" id="datePay">
        </div>
      </section>
      
      <section class="Options">
        <label>TIPO DE INGRESO</label>
        <section class="incomeSelect">
          <input type="radio" id="Income1" name="income" value="1" checked>
          <label for="Income1">
            <JobIcon class="Icon" />
            Quincenal
          </label>
          <input type="radio" id="Income2" name="income" value="2">
          <label for="Income2">
            <OthersIcon class="Icon" />
            Otros
          </label>
          <div class="bg"></div>
        </section>
      </section>
      
      <section class="Period">
        <label>PERIODO</label>
        <section class="Period-select">
          <input type="radio" id="Period1" name="period" value="1" checked>
          <label for="Period1">Primero</label>
          <input type="radio" id="Period2" name="period" value="2">
          <label for="Period2">Segundo</label>
          <div class="bg"></div>
        </section>
        <script src="@scripts/pages/income.js"></script>
      </section>

      <section class="SaveIncome">
        <button id="saveIncome">GUARDAR INGRESOS</button>
      </section>
    </section>
  </main>
</Layout>

<script define:vars={{ userId }}>
  window.currentUserId = userId;
</script>