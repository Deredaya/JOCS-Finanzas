---
import '@styles/index.scss'
import Layout from '@layouts/Layout.astro';
import IncomeIcon from '@icons/index/Income.astro';
import ExpenseIcon from '@icons/index/Expense.astro';
import DailyIcon from '@icons/index/DailyExpense.astro'

import { supabase } from "@/lib/supabase"
import { SignIn, SignOut } from 'auth-astro/components'
import { getSession } from 'auth-astro/server';

// --- IMPORTACIÓN DE ICONOS DINÁMICOS ---
import { ICON_LIST } from '@components/Icons';

const session = await getSession(Astro.request)
// const session = true
const userId = session?.user?.id;

if (session?.user) {
  const userId = session.user.id;

  // Sincronización del usuario con la base de datos
  await supabase
    .from('User-Finances')
    .upsert({ 
      id: userId,
      email: session.user.email,
      name: session.user.name,
      avatar_url: session.user.image,
      updated_at: new Date().toISOString()
    }, { onConflict: 'id' });
  
  // Inicialización de datos financieros si no existen
  const { data: existingFinance } = await supabase
    .from('FinanceData')
    .select('id')
    .eq('id', userId)
    .single();

  if (!existingFinance) {
    await supabase
      .from('FinanceData')
      .insert({ 
        id: userId,
        global_amount: 0
      });
  } 
}
---

<Layout title="Administración de Ingresos">
  <main class="content">
    {
    session ?
    <>
      <section class="Log">
        <section class="global-data">
          <p class="title">SALDO COMBINADO TOTAL</p>
          <p class="cash" id="cash">$--,---.--</p>
        </section>

        <section class="actions">
          <p class="title">ACCIONES RÁPIDAS</p>
          <div class="btns">
            <a href="/income" class="card">
              <article class="bg-icon">
                <IncomeIcon class="Icon"/>
              </article>
              <p>Agregar Ingresos</p>
            </a>
            <a href="/monthEntry" class="card">
              <article class="bg-icon">
                <ExpenseIcon class="Icon"/>
              </article>
              <p>Gastos</p>
            </a>
            <a href="/dailyEntry" class="card">
              <article class="bg-icon">
                <DailyIcon class="Icon"/>
              </article>
              <p>Gastos diarios</p>
            </a>
          </div>
        </section>

        <div class="register">
          <p class="title">Gastos Principales</p>
          <section id="expenses-container" class="expenses-grid">
            <div class="loader">Cargando movimientos...</div>
          </section>
        </div>
      </section>
    </>
    :
    <>
      <section class="Unlog">
        <p>¿Quieres saber por qué nunca tienes dinero a final de quincena?</p>
        <p>Inicia sesión ahora mismo</p>
        <SignIn class="btn">Iniciar Sesión</SignIn>
      </section>
    </>
  }
  </main>

  <div id="icon-dictionary" style="display: none;" aria-hidden="true">
    {
      ICON_LIST.map(({ name, component: Icon }) => (
        <div data-icon-name={name}>
          <Icon class="icon-svg-render" />
        </div>
      ))
    }
  </div>
</Layout>

<script define:vars={{ userId }}>
  // Pasamos el ID del usuario de la sesión de servidor al objeto window del cliente
  window.currentUserId = userId;
</script>

<script src="@scripts/pages/index.js"></script>