---
import '@styles/index.scss'
import Layout from '@layouts/Layout.astro';
import IncomeIcon from '@icons/index/Income.astro';
import ExpenseIcon from '@icons/index/Expense.astro';
import DailyIcon from '@icons/index/DailyExpense.astro'

import { supabase } from "@/lib/supabase"
import {SignIn,SignOut} from 'auth-astro/components'
import { getSession } from 'auth-astro/server';
const session = await getSession(Astro.request)
const userId = session?.user?.id;

// const ession = true

// console.log("Estado de la sesión:", session ? "Sesión activa" : "No hay sesión");

if (session?.user) {
  const userId = session.user.id;

  await supabase
    .from('User-Finances')
    .upsert({ 
      id: userId,
      email: session.user.email,
      nombre: session.user.name,
      avatar: session.user.image,
      actualizado_at: new Date().toISOString()
    }, { onConflict: 'id' });

  const { data: existingFinance } = await supabase
    .from('FinanceData')
    .select('id')
    .eq('id', userId)
    .single();

  if (!existingFinance) {
    const { error: insertError } = await supabase
      .from('FinanceData')
      .insert({ 
        id: userId,
        global_amount: 0
      });
  } 
}
---

<Layout title="Administracion de Ingresos">
  <main class="content">
    {
    session ?
    <>
      {/* TO DO: Aqui cargaremos los datos si el usuario ya inicio sesion */}
      <section class="Log">
        <section class="global-data">
          <p class="title">SALDO COMBINADO TOTAL</p>
          <p class="cash" id="cash">$--,---.--</p>
        </section>

        <section class="actions">
          <p class="title">ACCIONES RAPIDAS</p>
          <div class="btns">
            <a href="/income" class="card">
              <article class="bg-icon">
                <IncomeIcon class="Icon"/>
              </article>
              <p>Agregar Ingresos</p>
            </a>
            <a href="/monthEntry" class="card">
              <article class="bg-icon">
                <ExpenseIcon class="Icon"/>
              </article>
              <p>Gastos</p>
            </a>
            <a href="/dailyEntry" class="card">
              <article class="bg-icon">
                <DailyIcon class="Icon"/>
              </article>
              <p>Gastos diarios</p>
            </a>
          </div>
        </section>

        <div class="register">
          <p>Gastos Principales</p>
          <section class="table-container">
            <article class="DateData"></article>
            <article class="NameExpense"></article>
            <article class="Debt"></article>
            <article class="Pass"></article>
            <article class="PassNumb"></article>
          </section>
        </div>
      </section>
    </>
    :
    <>
      <section class="Unlog">
        <p>¿Quieres saber por que nunca tienes dinero a final de quincena?</p>
        <p>Inicia Sesion ahora mismo</p>
        <SignIn class="btn">Iniciar Sesion</SignIn>
        {/* <a class="btn" href="#Iniciar-Sesion">Iniciar Sesion</a> */}
      </section>
    </>
  }
  </main>
</Layout>

<script define:vars={{ userId }}>
  window.currentUserId = userId;
</script>

<script src="@scripts/pages/index.js"></script>
