---
import '@styles/index.scss'
import Layout from '@layouts/Layout.astro';
import IncomeIcon from '@icons/index/Income.astro';
import ExpenseIcon from '@icons/index/Expense.astro';
import DailyIcon from '@icons/index/DailyExpense.astro'

import { supabase } from "@/lib/supabase"
import { SignIn, SignOut } from 'auth-astro/components'
import { getSession } from 'auth-astro/server';

// --- IMPORTACIÓN DE ICONOS DINÁMICOS ---
import { ICON_LIST } from '@components/Icons';

const session = await getSession(Astro.request)
// const session = true
const userId = session?.user?.id;

if (session?.user) {
  const userId = session.user.id;

  // Sincronización del usuario con la base de datos
  await supabase
    .from('User-Finances')
    .upsert({ 
      id: userId,
      email: session.user.email,
      name: session.user.name,
      avatar_url: session.user.image,
      updated_at: new Date().toISOString()
    }, { onConflict: 'id' });
  
  // Inicialización de datos financieros si no existen
  const { data: existingFinance } = await supabase
    .from('FinanceData')
    .select('id')
    .eq('id', userId)
    .single();

  if (!existingFinance) {
    await supabase
      .from('FinanceData')
      .insert({ 
        id: userId,
        global_amount: 0
      });
  } 
}
---

<Layout title="Administración de Ingresos">
  <main class="content">
    {
    session ?
    <>
      <section class="Log">
        <section class="global-data">
          <p class="title">SALDO COMBINADO TOTAL</p>
          <p class="cash" id="cash">$--,---.--</p>
          <p class="entryInfo" id="entryInformation">Información del periodo</p>
        </section>

        <section class="actions">
          <p class="title">ACCIONES RÁPIDAS</p>
          <div class="btns">
            <a href="/income" class="card">
              <article class="bg-icon">
                <IncomeIcon class="Icon"/>
              </article>
              <p>Agregar Ingresos</p>
            </a>
            <a href="/monthEntry" class="card">
              <article class="bg-icon">
                <ExpenseIcon class="Icon"/>
              </article>
              <p>Gastos</p>
            </a>
            <a href="/dailyEntry" class="card">
              <article class="bg-icon">
                <DailyIcon class="Icon"/>
              </article>
              <p>Gastos diarios</p>
            </a>
          </div>
        </section>

        <div class="register">
          <p class="title">Gastos Principales</p>
          <section id="expenses-container" class="expenses-grid">
            <div class="loader">Cargando movimientos...</div>
          </section>
        </div>
      </section>
    </>
    :
    <>
      <section class="Unlog">
        <p>¿Quieres saber por qué nunca tienes dinero a final de quincena?</p>
        <p>Inicia sesión ahora mismo</p>
        <SignIn class="btn">Iniciar Sesión</SignIn>
      </section>
    </>
  }
  </main>

  <div id="icon-dictionary" style="display: none;" aria-hidden="true">
    {
      ICON_LIST.map(({ name, component: Icon }) => (
        <div data-icon-name={name}>
          <Icon class="icon-svg-render" />
        </div>
      ))
    }
  </div>
  <!-- Menú de Acciones (Botones) -->
  <div id="actionMenu" class="modal-overlay" style="display:none;">
    <div class="action-sheet">
      <button id="btnMarkPaid" class="action-btn primary">Marcar como Pagado</button>
      <button id="btnEditCard" class="action-btn">Editar Gasto</button>
      <button id="btnDeleteCard" class="action-btn danger">Borrar Gasto</button>
      <hr>
      <button id="btnCancelAction" class="action-btn cancel">Cancelar</button>
    </div>
  </div>

  <!-- Modal de Edición -->
  <div id="editModal" class="modal-overlay" style="display:none;">
    <div class="edit-card-modal">
      <h3>Editar Detalles</h3>
      
      <div class="input-group">
        <label>Concepto</label>
        <input type="text" id="editNameEntry">
      </div>

      <div class="input-group">
        <label>Día de Pago (Fecha)</label>
        <input type="date" id="editRegisterDate">
      </div>
      
      <div class="input-icon-group">
        <div class="input-group">
          <p>Icono</p>
          <div class="icon-selector-wrapper">
            <a class="popupIcons" id="openIconModal" data-selected="Others">
              <span id="currentEditIconPlaceholder"></span>
            </a>
          </div>
        </div>

        <div class="input-group">
          <label>Pagos Realizados</label>
          <input type="number" id="editPaymentsMade">
        </div>
      </div>

      <div class="input-group">
        <label>Monto Mensual</label>
        <input type="number" id="editNumberPayments">
      </div>

      <div class="modal-actions">
        <button id="btnCancelEdit" class="btn-sec">Cancelar</button>
        <button id="btnSaveEdit" class="btn-pri">Guardar</button>
      </div>
    </div>
  </div>

  <div id="iconModal" class="modal-overlay-icon">
    <div class="modal-content">
      <h3>Selecciona un Icono</h3>
      <div class="icon-grid">
        {ICON_LIST.map(({ name, component: Icon }) => (
          <button class="icon-option" data-icon={name}>
            <Icon class="iconPopup" />
          </button>
        ))}
      </div>
      <button id="closeModalIcon" class="btn-cancel">Cancelar</button>
    </div>
  </div>
</Layout>

<script define:vars={{ userId }}>
  // Pasamos el ID del usuario de la sesión de servidor al objeto window del cliente
  window.currentUserId = userId;
</script>

<script src="@scripts/pages/index.js"></script>