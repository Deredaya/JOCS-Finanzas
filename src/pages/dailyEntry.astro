---
import '@styles/dailyEntry.scss'
import Layout from '@layouts/Layout.astro'

import FoodIcon from '@icons/dailyEntry/Food.astro'
import TrasportIcon from '@icons/dailyEntry/Transport.astro'
import TradeIcon from '@icons/dailyEntry/Trade.astro'
import OthersIcon from '@icons/Others.astro'
---

<Layout title="Ingresa los gastos">
  <main class="dailyEntry">
    <label class="text">GASTOS DIARIOS</label>

    <section class="fortnightly">
      <div class="background">
        <label class="title">Ingresar Gasto</label>
        <input type="text" id="moneda" inputmode="decimal" placeholder="$0.00">

        <script src="@scripts/components/cashInput.js"></script>

        <section class="category">
          <label class="title">Seleccionar Categoria</label>
          <div class="selections">
            <input type="radio" name="cat" id="Category1" value="1" checked>
            <label for="Category1">
              <FoodIcon class="icon" />
              Comida
            </label>
            <input type="radio" name="cat" id="Category2" value="2">
            <label for="Category2">
              <TrasportIcon class="icon"/>  
              Transporte
            </label>
            <input type="radio" name="cat" id="Category3" value="3">
            <label for="Category3">
              <TradeIcon class="icon" />
              Negocio
            </label>
            <input type="radio" name="cat" id="Category4" value="4">
            <label for="Category4">
              <OthersIcon class="icon" />
              Otros
            </label>
          </div>
          <button>Agregar Gasto</button>
        </section>
      </div>

      <section class="register">
        <div class="heading">
          <label>Movimientos Diarios</label>
          <a href="#">Ver todo</a>
        </div>

        <section class="tableData" id="tableData">
        </section>
      </section>
    </section>
  </main>
</Layout>