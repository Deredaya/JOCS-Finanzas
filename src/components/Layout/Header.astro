---
import '@styles/header.scss'
import {SignIn,SignOut} from 'auth-astro/components'
// import { getSession } from 'auth-astro/server';
// const session = await getSession(Astro.request)
const session = true
import Logo from '@icons/Logo.astro';
import UserIcon from '@icons/header/user.astro';
import LogIcon from '@icons/header/userLog.astro';
---

<header class="container">
  <Logo class="Logo" id="home"/>
  <section class="User">
    {
      session ?
      <>
        {/* <img src={Imagen de Google} alt="" class="Signin"> */}
        <LogIcon class="Signin" id="Signin"/>
        <a class="popup" href="#Cerrar-Sesion">Cerrar Sesion</a>
      </>
      :
      <>
        <UserIcon class="Signin" id="Signin"/>
        <a class="popup" href="#Iniciar-Sesion">Iniciar Sesion</a>
      </>
      }
  </section>
</header>
<script src="@scripts/pages/header.js"></script>